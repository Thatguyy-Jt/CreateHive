# Copy to .env.local and fill in. Never commit real values.

# Clerk — https://dashboard.clerk.com → API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Supabase — Project Settings → API. Server-only: never prefix with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Bypasses Row Level Security. Used only by lib/supabase/admin.ts.
SUPABASE_SECRET_KEY=
